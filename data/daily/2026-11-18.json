[{"id":"inc-2026-1118-013","title":"퀘벡코르, 텔러스에 310억 캐나다달러 인수 제안…규제 장벽 부각","category":"MKT","severity":"low","country":"CA","countryName":"캐나다","region":"North America","lat":56.1,"lng":-106.3,"source":"Telecompaper","sourceUrl":"https://www.telecompaper.com/news/telus-receives-unsolicited-takeover-offer-from-quebecor--1589022","date":"2026-11-16","summary":"퀘벡코르가 현금·주식 방식의 310억 캐나다달러 규모 텔러스 인수를 제안했으나 텔러스 이사회는 특별위원회를 꾸려 중대한 위험을 검토 중이다. 성사 시 캐나다 전국 이동통신망이 3개에서 2개로 줄어 경쟁당국 심사가 불가피하며 애널리스트들은 성사 가능성을 낮게 본다.","tags":["telecom","m-and-a","canada","competition"],"score":26,"scoreFactors":{"target":10,"exploit":0,"technical":5,"scale":8,"domestic":3},"nonThreat":true,"crossCheckUrls":["https://bnnbloomberg.ca/business/company-news/2026/11/17/quebecors-proposed-telus-takeover-faces-challenging-road-ahead-analysts"],"cves":[],"trust":60,"sourceTier":"T2","sourceGrade":"C"},{"id":"inc-2026-1118-012","title":"LG유플러스, 네트워크·보안 통합 'U+SASE' 정식 출시","category":"TEL","severity":"low","country":"KR","countryName":"대한민국","region":"Asia","lat":37.5665,"lng":126.978,"source":"디지털데일리","sourceUrl":"https://www.ddaily.co.kr/page/view/2026111609273380236","date":"2026-11-16","summary":"LG유플러스가 SWG·FWaaS·CASB·ZTNA와 생성형 AI 데이터 유출 차단을 묶은 기업용 클라우드 보안 플랫폼 U+SASE를 출시했다. 모니터랩과 공동 개발했고 24시간 관제를 제공하며 가격은 공개되지 않았다. 향후 엔드포인트·클라우드 모니터링과 CSMA로 확장할 계획이다.","tags":["telecom","sase","zero-trust","product-launch"],"score":33,"scoreFactors":{"target":10,"exploit":0,"technical":5,"scale":3,"domestic":15},"nonThreat":true,"crossCheckUrls":["https://www.newsspace.kr/news/article.html?no=16692"],"cves":[],"trust":60,"sourceTier":"T2","sourcePending":true,"sourceGrade":"D"},{"id":"inc-2026-1118-011","title":"싱가포르 CSA, 11월 이후 월평균 사이버 사고 3배 증가 경보","category":"REG","severity":"medium","country":"SG","countryName":"싱가포르","region":"Asia","lat":1.3521,"lng":103.8198,"source":"싱가포르 CSA","sourceUrl":"https://www.csa.gov.sg/alerts-and-advisories/advisories/ad-2026-017/","date":"2026-11-13","summary":"싱가포르 사이버보안청(CSA)이 11월 13일 권고문 AD-2026-017을 내고 9월 이후 월평균 신고 사고가 1~8월 평균의 3배라고 밝혔다. 일부는 제3자 공급업체 침해와 연계됐으며 AI로 스캔·사회공학·취약점 악용 속도가 빨라지고 있다고 진단했다. 인터넷 노출 시스템 패치, 외부 자산 점검, 피싱 방지 MFA 적용 등을 권고했다.","tags":["advisory","incident-trend","supply-chain","singapore"],"score":36,"scoreFactors":{"target":10,"exploit":5,"technical":5,"scale":8,"domestic":8},"nonThreat":true,"crossCheckUrls":[],"cves":[],"trust":70,"sourceTier":"T1","sourceGrade":"A"},{"id":"inc-2026-1118-010","title":"바라쿠다, 미회수 AI 벤더용 클라우드 키로 44시간 침입 당해","category":"INC","severity":"medium","country":"US","countryName":"미국","region":"North America","lat":37.39,"lng":-122.08,"source":"Barracuda Blog","sourceUrl":"https://blog.barracuda.com/2026/11/11/anatomy-of-a-machine-speed-intrusion","date":"2026-11-11","summary":"바라쿠다는 외부 AI 업체에 줬다가 회수하지 않은 클라우드 접근 키로 공격자가 11월 1~2일 약 44시간 동안 클라우드 계정 약 10곳에 침투했다고 공개했다. XDR 고객 연동 자격증명이 노출됐을 가능성이 있어 일부 고객에 재발급을 요청했다.","tags":["supply-chain","cloud","credential-theft","ai"],"score":46,"scoreFactors":{"target":10,"exploit":15,"technical":10,"scale":8,"domestic":3},"crossCheckUrls":["https://news.risky.biz/risky-bulletin-hackers-accessed-barracudas-cloud/"],"cves":[],"trust":70,"sourceTier":"T1","sourceGrade":"B"},{"id":"inc-2026-1118-009","title":"TSMC 임직원 약 4.6만 명 개인정보 유출 확인, 클라우드 업체 연루","category":"INC","severity":"medium","country":"TW","countryName":"대만","region":"Asia","lat":24.77,"lng":121.01,"source":"BleepingComputer","sourceUrl":"https://www.bleepingcomputer.com/news/security/tsmc-employee-data-breach-linked-to-cloud-provider/","date":"2026-11-15","summary":"TSMC는 현직·전직 임직원 개인정보가 무단 게시됐음을 인정했다. 공격자는 약 4.6만 건 규모 데이터를 3BTC부터 판매 제안했으며 TSMC는 자사 시스템이 아닌 외부 클라우드 서비스 업체 데이터와 일치한다고 밝혔다.","tags":["data-breach","third-party","extortion","semiconductor"],"score":51,"scoreFactors":{"target":10,"exploit":15,"technical":10,"scale":8,"domestic":8},"crossCheckUrls":["https://therecord.media/tsmc-confirms-employee-data-breach-cloud-provider"],"cves":[],"trust":75,"sourceTier":"T2","sourceGrade":"C"},{"id":"inc-2026